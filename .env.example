# Токен тестового бота из @BotFather. Боевой токен — только на сервере, токены не смешивать.
BOT_TOKEN=
# Telegram ID организатора (узнать свой — @userinfobot). Ему приходит панель админа.
ORGANIZER_ID=
# Telegram ID админов через запятую: получают свою панель админа и команды организатора. Права — по ID, не по username.
ADMIN_IDS=

# Параметры первого турнира — берутся при первом запуске. Дальше их меняет организатор в панели
# («⚙️ Настройки»), а новые турниры создаёт там же («🗂 Все турниры») с настройками текущего.
TOURNAMENT_TITLE=Музыкальный турнир
# Код ссылки-приглашения t.me/<бот>?start=t_<код>. Пусто — случайный.
TOURNAMENT_CODE=
# Число финалистов: степень двойки. Для пробы на 3–4 аккаунтах — 2.
FINALISTS=8
# Треков в матче отбора. Отрыв для победы после них (по умолчанию 2,0) — в ⚙️ Настройках.
QUALIFIER_TRACKS=5
MAX_SUBMISSIONS=10
# Сколько песен уходит в финальный пул. Пусто — 120, под финал на 8 человек.
# Для пробы на 4 аккаунтах — 20, иначе все песни уйдут в финал и отбору нечего играть.
FINAL_POOL_TARGET=
# Длина игрового фрагмента, секунд. Начало выбирает автор песни на сборе.
FRAGMENT_SECONDS=60
# Срок круга отбора, дней от жеребьёвки. 0 или пусто — без сроков. Меняется и в ⚙️ Настройках, пока идёт сбор.
ROUND_DAYS=
# Seed жеребьёвки и пулов. Пусто — случайный.
SEED=

# Аудио: ffmpeg — обезличенные фрагменты (нужен ffmpeg и SERVICE_CHAT_ID), skip — без обработки, судья видит заглушку.
AUDIO_MODE=ffmpeg
# Служебный чат, куда бот один раз отправляет игровые версии, чтобы получить их file_id.
# Подойдёт личный чат организатора с ботом (тот же ID) или закрытый канал, где бот — админ.
SERVICE_CHAT_ID=

# База данных: нужна одна из двух строк ниже, смотря как запускаете.
# Docker Compose — придумать пароль для базы из латинских букв и цифр. Адрес базы compose соберёт сам.
POSTGRES_PASSWORD=
# npm run bot без Docker — адрес PostgreSQL. Значение ниже — оно же по умолчанию — подходит для PostgreSQL из Homebrew (вход без пароля).
# Если у базы есть пользователь и пароль: postgres://пользователь:пароль@localhost:5432/tournament
DATABASE_URL=postgres://localhost:5432/tournament
# Временные файлы обработки аудио.
TMP_DIR=data/tmp
# Docker Compose: копия базы в ./backups раз в N минут, 0 — выключить.
BACKUP_MINUTES=5
