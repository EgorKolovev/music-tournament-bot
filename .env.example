# Токен тестового бота из @BotFather. Боевой токен — только на сервере, токены не смешивать.
BOT_TOKEN=
# Telegram ID организатора (узнать свой — @userinfobot). Ему приходят панели этапов.
ORGANIZER_ID=
# Telegram ID админов через запятую: могут выполнять команды организатора. Права — по ID, не по username.
ADMIN_IDS=

# Параметры турнира фиксируются в базе при первом запуске.
TOURNAMENT_TITLE=Музыкальный турнир
# Код ссылки-приглашения t.me/<бот>?start=t_<код>. Пусто — случайный.
TOURNAMENT_CODE=
# Число финалистов: степень двойки. Для пробы на 3–4 аккаунтах — 2.
FINALISTS=8
QUALIFIER_TRACKS=5
MAX_SUBMISSIONS=10
# Срок круга отбора, дней от жеребьёвки.
ROUND_DAYS=7
# Seed жеребьёвки и пулов. Пусто — случайный.
SEED=

# Аудио: ffmpeg — обезличенные фрагменты (нужен ffmpeg и SERVICE_CHAT_ID), skip — без обработки, судья видит заглушку.
AUDIO_MODE=ffmpeg
# Служебный чат, куда бот один раз отправляет игровые версии, чтобы получить их file_id.
# Подойдёт личный чат организатора с ботом (тот же ID) или закрытый канал, где бот — админ.
SERVICE_CHAT_ID=

# База PostgreSQL. В Docker Compose пароль задаёт POSTGRES_PASSWORD, а DATABASE_URL собирается сам.
# Пароль — латинские буквы и цифры: он подставляется в URL.
POSTGRES_PASSWORD=
# Для npm run bot без Docker — адрес своего PostgreSQL.
DATABASE_URL=postgres://tournament:пароль@localhost:5432/tournament
# Временные файлы обработки аудио.
TMP_DIR=data/tmp
# Docker Compose: копия базы в ./backups раз в N минут, 0 — выключить.
BACKUP_MINUTES=5
