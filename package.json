{
  "name": "music-tournament-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram-бот для очных музыкальных матчей между двумя игроками с выбранным ими судьёй и для подготовки автономного финала.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "bot": "node --env-file-if-exists=.env src/telegram/main.ts",
    "db:backup": "node --env-file-if-exists=.env src/storage/cli.ts backup",
    "db:restore": "node --env-file-if-exists=.env src/storage/cli.ts restore",
    "db:reset": "node --env-file-if-exists=.env src/storage/cli.ts reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EgorKolovev/music-tournament-bot.git"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "grammy": "^1.30.0",
    "pg": "^8.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
